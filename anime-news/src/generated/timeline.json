  {
   "id": "S05",
   "chapter": "France: pressure in the streets",
   "startFrame": 3398,
   "durationFrames": 946,
   "planStartSec": 143,
   "planDurationSec": 37,
   "sourceIds": [
    "F04"
   ],
   "assetIds": [
    "A08",
    "A09",
    "A14"
   ],
   "cues": [
    {
     "id": "S05_01",
     "text": "In France, the pressure moved onto the streets.",
     "startFrame": 3404,
     "durationFrames": 67,
     "endFrame": 3471,
     "seconds": 2.785,
     "audio": "audio/narration_tts/S05_01.wav",
     "audioKind": "tts",
     "captionStart": 3404,
     "captionEnd": 3477
    },
    {
     "id": "S05_02",
     "text": "Saturday brought a third consecutive weekend of demonstrations",
     "startFrame": 3479,
     "durationFrames": 100,
     "endFrame": 3579,
     "seconds": 4.15,
     "audio": "audio/narration_tts/S05_02.wav",
     "audioKind": "tts",
     "captionStart": 3479,
     "captionEnd": 3583
    },
    {
     "id": "S05_03",
     "text": "over living costs and education.",
     "startFrame": 3583,
     "durationFrames": 64,
     "endFrame": 3647,
     "seconds": 2.627,
     "audio": "audio/narration_tts/S05_03.wav",
     "audioKind": "tts",
     "captionStart": 3583,
     "captionEnd": 3653
    },
    {
     "id": "S05_04",
     "text": "Authorities estimated three-hundred-and-twenty-thousand participants across the country.",
     "startFrame": 3655,
     "durationFrames": 128,
     "endFrame": 3783,
     "seconds": 5.294,
     "audio": "audio/narration_tts/S05_04.wav",
     "audioKind": "tts",
     "captionStart": 3655,
     "captionEnd": 3789
    },
    {
     "id": "S05_05",
     "text": "Organizers put the number higher.",
     "startFrame": 3791,
     "durationFrames": 54,
     "endFrame": 3845,
     "seconds": 2.233,
     "audio": "audio/narration_tts/S05_05.wav",
     "audioKind": "tts",
     "captionStart": 3791,
     "captionEnd": 3851
    },
    {
     "id": "S05_06",
     "text": "Most people marched peacefully.",
