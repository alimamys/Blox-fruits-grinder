     "endFrame": 3786,
     "seconds": 1.576,
     "audio": "audio/narration_scratch/S05_06.wav",
     "audioKind": "scratch",
     "captionStart": 3748,
     "captionEnd": 3792
    },
    {
     "id": "S05_07",
     "text": "Later clashes involving smaller groups broke out in Paris and other cities.",
     "startFrame": 3800,
     "durationFrames": 114,
