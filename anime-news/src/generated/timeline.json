     "durationFrames": 46,
     "endFrame": 3908,
     "seconds": 1.909,
     "audio": "audio/narration_tts/S05_06.wav",
     "audioKind": "tts",
     "captionStart": 3862,
     "captionEnd": 3914
    },
    {
     "id": "S05_07",
     "text": "Later clashes involving smaller groups broke out in Paris and other cities.",
     "startFrame": 3922,
     "durationFrames": 114,
     "endFrame": 4036,
     "seconds": 4.73,
     "audio": "audio/narration_tts/S05_07.wav",
     "audioKind": "tts",
     "captionStart": 3922,
     "captionEnd": 4042
    },
    {
