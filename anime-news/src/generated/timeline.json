     "startFrame": 2352,
     "durationFrames": 115,
     "endFrame": 2467,
     "seconds": 4.756,
     "audio": "audio/narration_scratch/S04_01.wav",
     "audioKind": "scratch",
     "captionStart": 2352,
     "captionEnd": 2473
    },
    {
     "id": "S04_02",
     "text": "On Saturday, evacuees from Russian-occupied Oleshky reached Ukrainian-held territory",
     "startFrame": 2475,
     "durationFrames": 125,
     "endFrame": 2600,
     "seconds": 5.184,
     "audio": "audio/narration_scratch/S04_02.wav",
     "audioKind": "scratch",
     "captionStart": 2475,
     "captionEnd": 2604
    },
    {
     "id": "S04_03",
     "text": "and reunited with relatives.",
