     "text": "The movement’s demands have broadened to include civil liberties and the right to protest.",
     "startFrame": 4044,
     "durationFrames": 119,
     "endFrame": 4163,
     "seconds": 4.924,
     "audio": "audio/narration_tts/S05_08.wav",
     "audioKind": "tts",
     "captionStart": 4044,
     "captionEnd": 4169
    },
