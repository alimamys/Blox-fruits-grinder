  {
   "id": "S03",
   "chapter": "Israel: the arithmetic of power",
   "startFrame": 1386,
   "durationFrames": 958,
   "planStartSec": 62,
   "planDurationSec": 41,
   "sourceIds": [
    "F02"
   ],
   "assetIds": [
    "A04",
    "A05",
    "A15"
   ],
   "cues": [
    {
     "id": "S03_01",
     "text": "In Israel, the votes are counted. Forming a government is the next battle.",
     "startFrame": 1392,
     "durationFrames": 125,
     "endFrame": 1517,
     "seconds": 5.185,
     "audio": "audio/narration_scratch/S03_01.wav",
     "audioKind": "scratch",
     "captionStart": 1392,
     "captionEnd": 1523
    },
    {
     "id": "S03_02",
     "text": "Results released on Friday gave Benjamin Netanyahu’s bloc fifty-three seats.",
     "startFrame": 1525,
     "durationFrames": 106,
     "endFrame": 1631,
     "seconds": 4.401,
     "audio": "audio/narration_scratch/S03_02.wav",
     "audioKind": "scratch",
     "captionStart": 1525,
     "captionEnd": 1637
    },
    {
     "id": "S03_03",
     "text": "The main opposition bloc took forty-eight.",
     "startFrame": 1641,
     "durationFrames": 63,
     "endFrame": 1704,
     "seconds": 2.598,
     "audio": "audio/narration_scratch/S03_03.wav",
     "audioKind": "scratch",
     "captionStart": 1641,
     "captionEnd": 1710
    },
    {
     "id": "S03_04",
     "text": "Arab-led parties held nineteen.",
     "startFrame": 1714,
     "durationFrames": 48,
     "endFrame": 1762,
     "seconds": 1.997,
     "audio": "audio/narration_scratch/S03_04.wav",
     "audioKind": "scratch",
     "captionStart": 1714,
     "captionEnd": 1768
    },
    {
     "id": "S03_05",
     "text": "For an outright majority, the target is sixty-one seats",
     "startFrame": 1774,
     "durationFrames": 96,
     "endFrame": 1870,
     "seconds": 3.972,
     "audio": "audio/narration_scratch/S03_05.wav",
     "audioKind": "scratch",
     "captionStart": 1774,
     "captionEnd": 1874
    },
    {
     "id": "S03_06",
     "text": "in the one-hundred-and-twenty-seat parliament.",
     "startFrame": 1874,
     "durationFrames": 62,
     "endFrame": 1936,
     "seconds": 2.568,
     "audio": "audio/narration_scratch/S03_06.wav",
     "audioKind": "scratch",
     "captionStart": 1874,
     "captionEnd": 1942
    },
    {
     "id": "S03_07",
     "text": "Netanyahu remains prime minister while parties try to build a coalition.",
     "startFrame": 1954,
     "durationFrames": 106,
     "endFrame": 2060,
     "seconds": 4.388,
     "audio": "audio/narration_scratch/S03_07.wav",
     "audioKind": "scratch",
     "captionStart": 1954,
     "captionEnd": 2066
    },
    {
     "id": "S03_08",
     "text": "Those nineteen seats do not automatically belong to either main bloc.",
     "startFrame": 2068,
     "durationFrames": 104,
     "endFrame": 2172,
     "seconds": 4.312,
     "audio": "audio/narration_scratch/S03_08.wav",
     "audioKind": "scratch",
     "captionStart": 2068,
     "captionEnd": 2178
    },
    {
     "id": "S03_09",
     "text": "The election is over.",
     "startFrame": 2180,
     "durationFrames": 32,
     "endFrame": 2212,
     "seconds": 1.304,
     "audio": "audio/narration_scratch/S03_09.wav",
     "audioKind": "scratch",
     "captionStart": 2180,
     "captionEnd": 2218
    },
    {
     "id": "S03_10",
     "text": "The struggle to turn votes into a governing majority continues.",
     "startFrame": 2220,
     "durationFrames": 94,
     "endFrame": 2314,
     "seconds": 3.889,
     "audio": "audio/narration_scratch/S03_10.wav",
     "audioKind": "scratch",
     "captionStart": 2220,
     "captionEnd": 2320
    }
   ],
