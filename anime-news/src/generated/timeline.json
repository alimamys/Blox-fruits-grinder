     "seconds": 2.295,
     "audio": "audio/narration_scratch/S04_04.wav",
     "audioKind": "scratch",
     "captionStart": 2651,
     "captionEnd": 2711
    },
    {
     "id": "S04_05",
     "text": "under a local ceasefire that also allowed humanitarian aid.",
     "startFrame": 2711,
     "durationFrames": 87,
     "endFrame": 2798,
     "seconds": 3.602,
     "audio": "audio/narration_scratch/S04_05.wav",
     "audioKind": "scratch",
     "captionStart": 2711,
     "captionEnd": 2804
    },
    {
     "id": "S04_06",
     "text": "That pause began on Tuesday and was scheduled to end on Sunday evening.",
     "startFrame": 2806,
     "durationFrames": 99,
     "endFrame": 2905,
     "seconds": 4.105,
     "audio": "audio/narration_scratch/S04_06.wav",
     "audioKind": "scratch",
     "captionStart": 2806,
     "captionEnd": 2911
    },
    {
     "id": "S04_07",
     "text": "It covered a limited area.",
     "startFrame": 2913,
     "durationFrames": 43,
     "endFrame": 2956,
     "seconds": 1.771,
     "audio": "audio/narration_scratch/S04_07.wav",
     "audioKind": "scratch",
     "captionStart": 2913,
     "captionEnd": 2962
    },
    {
     "id": "S04_08",
     "text": "Fighting continued elsewhere in Ukraine. The wider war went on.",
     "startFrame": 2964,
     "durationFrames": 96,
     "endFrame": 3060,
     "seconds": 3.984,
     "audio": "audio/narration_scratch/S04_08.wav",
     "audioKind": "scratch",
     "captionStart": 2964,
     "captionEnd": 3066
    },
