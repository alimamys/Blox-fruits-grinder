    "A14"
   ],
   "cues": [
    {
     "id": "S04_01",
     "text": "Now to Ukraine, where this week brought a narrow opening for civilians.",
     "startFrame": 2388,
     "durationFrames": 100,
     "endFrame": 2488,
     "seconds": 4.154,
     "audio": "audio/narration_tts/S04_01.wav",
     "audioKind": "tts",
     "captionStart": 2388,
     "captionEnd": 2494
    },
    {
     "id": "S04_02",
     "text": "On Saturday, evacuees from Russian-occupied Oleshky reached Ukrainian-held territory",
     "startFrame": 2496,
     "durationFrames": 141,
     "endFrame": 2637,
     "seconds": 5.842,
     "audio": "audio/narration_tts/S04_02.wav",
     "audioKind": "tts",
     "captionStart": 2496,
     "captionEnd": 2641
    },
    {
     "id": "S04_03",
     "text": "and reunited with relatives.",
     "startFrame": 2641,
     "durationFrames": 48,
     "endFrame": 2689,
     "seconds": 1.988,
     "audio": "audio/narration_tts/S04_03.wav",
     "audioKind": "tts",
     "captionStart": 2641,
     "captionEnd": 2695
    },
    {
     "id": "S04_04",
     "text": "Their route ran through Russia and Belarus,",
     "startFrame": 2697,
     "durationFrames": 69,
     "endFrame": 2766,
     "seconds": 2.839,
     "audio": "audio/narration_tts/S04_04.wav",
     "audioKind": "tts",
     "captionStart": 2697,
     "captionEnd": 2770
    },
    {
     "id": "S04_05",
     "text": "under a local ceasefire that also allowed humanitarian aid.",
     "startFrame": 2770,
     "durationFrames": 98,
     "endFrame": 2868,
     "seconds": 4.06,
     "audio": "audio/narration_tts/S04_05.wav",
     "audioKind": "tts",
     "captionStart": 2770,
     "captionEnd": 2874
    },
    {
     "id": "S04_06",
     "text": "That pause began on Tuesday and was scheduled to end on Sunday evening.",
     "startFrame": 2876,
     "durationFrames": 103,
     "endFrame": 2979,
     "seconds": 4.289,
     "audio": "audio/narration_tts/S04_06.wav",
     "audioKind": "tts",
     "captionStart": 2876,
     "captionEnd": 2985
    },
    {
     "id": "S04_07",
     "text": "It covered a limited area.",
     "startFrame": 2987,
     "durationFrames": 44,
     "endFrame": 3031,
     "seconds": 1.819,
     "audio": "audio/narration_tts/S04_07.wav",
     "audioKind": "tts",
     "captionStart": 2987,
     "captionEnd": 3037
    },
    {
     "id": "S04_08",
     "text": "Fighting continued elsewhere in Ukraine. The wider war went on.",
     "startFrame": 3039,
     "durationFrames": 108,
     "endFrame": 3147,
     "seconds": 4.477,
     "audio": "audio/narration_tts/S04_08.wav",
     "audioKind": "tts",
     "captionStart": 3039,
     "captionEnd": 3153
    },
    {
     "id": "S04_09",
     "text": "But for families arriving at the border, the week brought something immediate:",
     "startFrame": 3163,
     "durationFrames": 96,
     "endFrame": 3259,
     "seconds": 3.995,
     "audio": "audio/narration_tts/S04_09.wav",
     "audioKind": "tts",
     "captionStart": 3163,
     "captionEnd": 3265
    },
    {
     "id": "S04_10",
     "text": "getting out, reaching safety, finding each other.",
     "startFrame": 3267,
     "durationFrames": 66,
     "endFrame": 3333,
     "seconds": 2.732,
     "audio": "audio/narration_tts/S04_10.wav",
     "audioKind": "tts",
     "captionStart": 3267,
     "captionEnd": 3339
    }
   ],
