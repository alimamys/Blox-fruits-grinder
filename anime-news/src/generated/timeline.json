  {
   "id": "S02",
   "chapter": "The Gulf: a proposal, not a deal",
   "startFrame": 462,
   "durationFrames": 937,
   "planStartSec": 18,
   "planDurationSec": 44,
   "sourceIds": [
    "F01"
   ],
   "assetIds": [
    "A01",
    "A03",
    "A02",
    "A14"
   ],
   "cues": [
    {
     "id": "S02_01",
     "text": "We start in the Gulf, where diplomacy continued under the threat of renewed strikes.",
     "startFrame": 468,
     "durationFrames": 119,
     "endFrame": 587,
     "seconds": 4.921,
     "audio": "audio/narration_tts/S02_01.wav",
     "audioKind": "tts",
     "captionStart": 468,
     "captionEnd": 593
    },
    {
     "id": "S02_02",
     "text": "On Sunday, Iranian negotiators were in Doha for talks with Qatari mediators,",
     "startFrame": 595,
     "durationFrames": 128,
     "endFrame": 723,
     "seconds": 5.331,
     "audio": "audio/narration_tts/S02_02.wav",
     "audioKind": "tts",
     "captionStart": 595,
     "captionEnd": 727
    },
    {
     "id": "S02_03",
     "text": "seeking a way to end the war involving Iran, the United States and Israel.",
     "startFrame": 727,
     "durationFrames": 114,
     "endFrame": 841,
     "seconds": 4.736,
     "audio": "audio/narration_tts/S02_03.wav",
     "audioKind": "tts",
     "captionStart": 727,
     "captionEnd": 847
    },
    {
     "id": "S02_04",
     "text": "Iran’s foreign minister described a proposal that could reopen the Strait of Hormuz",
     "startFrame": 849,
     "durationFrames": 120,
     "endFrame": 969,
     "seconds": 4.992,
     "audio": "audio/narration_tts/S02_04.wav",
     "audioKind": "tts",
     "captionStart": 849,
     "captionEnd": 973
    },
    {
     "id": "S02_05",
     "text": "within two days of a possible agreement with Washington.",
     "startFrame": 973,
     "durationFrames": 89,
     "endFrame": 1062,
     "seconds": 3.679,
     "audio": "audio/narration_tts/S02_05.wav",
     "audioKind": "tts",
     "captionStart": 973,
     "captionEnd": 1068
    },
    {
     "id": "S02_06",
     "text": "But he said no final agreement had been reached.",
     "startFrame": 1074,
     "durationFrames": 73,
     "endFrame": 1147,
     "seconds": 3.012,
     "audio": "audio/narration_tts/S02_06.wav",
     "audioKind": "tts",
     "captionStart": 1074,
     "captionEnd": 1153
    },
    {
     "id": "S02_07",
     "text": "The shipping route remains central to the negotiations.",
     "startFrame": 1159,
     "durationFrames": 82,
     "endFrame": 1241,
     "seconds": 3.385,
     "audio": "audio/narration_tts/S02_07.wav",
     "audioKind": "tts",
     "captionStart": 1159,
     "captionEnd": 1247
    },
    {
     "id": "S02_08",
     "text": "For now, the diplomatic breakthrough is still a possibility—not an announced outcome.",
     "startFrame": 1249,
     "durationFrames": 120,
     "endFrame": 1369,
     "seconds": 4.96,
     "audio": "audio/narration_tts/S02_08.wav",
     "audioKind": "tts",
     "captionStart": 1249,
     "captionEnd": 1375
    }
   ],
   "visualCues": [
    {
     "n": 1,
     "frame": 468,
     "text": "Wide sea-and-shipping illustration; slow lateral camera move and two layers of water motion."
    },
    {
     "n": 2,
     "frame": 595,
     "text": "Label DOHA • 1 NOV 2026. Cut to cel-shaded portrait of Abbas Araghchi, labelled with name and role."
    },
    {
     "n": 3,
     "frame": 727,
     "text": "Illustrative diplomatic corridor and a table with a folder. Symbolic staging, not a reconstruction."
    },
    {
     "n": 4,
     "frame": 969,
     "text": "Accurate code-rendered map inset of the Strait of Hormuz. No shipping shown returning to normal."
    },
    {
     "n": 5,
     "frame": 973,
     "text": "POSSIBLE AGREEMENT → PROPOSED REOPENING WITHIN 2 DAYS. Condition revealed before the number."
    },
    {
     "n": 6,
     "frame": 1074,
     "text": "Return to the folder, still unopened. Show TALKS CONTINUING. No signatures, no handshake."
    },
    {
     "n": 7,
     "frame": 1249,
     "text": "End on an amber desk light; match-cut into the next scene's chamber light. Source tag: Reuters / AP • 1 NOV."
    }
   ],
   "soundCues": [
    {
     "frame": 462,
     "text": "Distant water and a restrained ticking/percussion motif. Low tension; no missile or explosion sounds."
    }
   ]
