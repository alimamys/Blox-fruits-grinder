     "text": "The movement’s demands have broadened to include civil liberties and the right to protest.",
     "startFrame": 3922,
     "durationFrames": 120,
     "endFrame": 4042,
     "seconds": 4.991,
     "audio": "audio/narration_scratch/S05_08.wav",
     "audioKind": "scratch",
     "captionStart": 3922,
     "captionEnd": 4048
    },
    {
