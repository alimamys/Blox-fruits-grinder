   ],
   "assetIds": [
    "A06",
    "A07",
    "A14"
   ],
   "cues": [
    {
     "id": "S04_01",
     "text": "Now to Ukraine, where this week brought a narrow opening for civilians.",
     "startFrame": 2381,
     "durationFrames": 100,
     "endFrame": 2481,
     "seconds": 4.154,
     "audio": "audio/narration_tts/S04_01.wav",
     "audioKind": "tts",
     "captionStart": 2381,
     "captionEnd": 2487
    },
    {
     "id": "S04_02",
     "text": "On Saturday, evacuees from Russian-occupied Oleshky reached Ukrainian-held territory",
     "startFrame": 2489,
     "durationFrames": 141,
     "endFrame": 2630,
     "seconds": 5.842,
     "audio": "audio/narration_tts/S04_02.wav",
     "audioKind": "tts",
     "captionStart": 2489,
     "captionEnd": 2634
    },
    {
     "id": "S04_03",
     "text": "and reunited with relatives.",
     "startFrame": 2634,
     "durationFrames": 48,
     "endFrame": 2682,
     "seconds": 1.988,
     "audio": "audio/narration_tts/S04_03.wav",
     "audioKind": "tts",
     "captionStart": 2634,
     "captionEnd": 2688
    },
    {
     "id": "S04_04",
     "text": "Their route ran through Russia and Belarus,",
     "startFrame": 2690,
     "durationFrames": 69,
     "endFrame": 2759,
     "seconds": 2.839,
     "audio": "audio/narration_tts/S04_04.wav",
     "audioKind": "tts",
     "captionStart": 2690,
     "captionEnd": 2763
    },
    {
     "id": "S04_05",
     "text": "under a local ceasefire that also allowed humanitarian aid.",
     "startFrame": 2763,
     "durationFrames": 98,
     "endFrame": 2861,
     "seconds": 4.06,
     "audio": "audio/narration_tts/S04_05.wav",
     "audioKind": "tts",
     "captionStart": 2763,
     "captionEnd": 2867
    },
    {
     "id": "S04_06",
     "text": "That pause began on Tuesday and was scheduled to end on Sunday evening.",
     "startFrame": 2869,
     "durationFrames": 103,
     "endFrame": 2972,
     "seconds": 4.289,
     "audio": "audio/narration_tts/S04_06.wav",
     "audioKind": "tts",
     "captionStart": 2869,
     "captionEnd": 2978
    },
    {
     "id": "S04_07",
     "text": "It covered a limited area.",
     "startFrame": 2980,
     "durationFrames": 44,
     "endFrame": 3024,
     "seconds": 1.819,
     "audio": "audio/narration_tts/S04_07.wav",
     "audioKind": "tts",
     "captionStart": 2980,
     "captionEnd": 3030
    },
    {
     "id": "S04_08",
     "text": "Fighting continued elsewhere in Ukraine. The wider war went on.",
     "startFrame": 3032,
     "durationFrames": 108,
     "endFrame": 3140,
     "seconds": 4.477,
     "audio": "audio/narration_tts/S04_08.wav",
     "audioKind": "tts",
     "captionStart": 3032,
     "captionEnd": 3146
    },
    {
     "id": "S04_09",
     "text": "But for families arriving at the border, the week brought something immediate:",
     "startFrame": 3156,
     "durationFrames": 96,
     "endFrame": 3252,
     "seconds": 3.995,
     "audio": "audio/narration_tts/S04_09.wav",
     "audioKind": "tts",
     "captionStart": 3156,
     "captionEnd": 3258
    },
    {
     "id": "S04_10",
     "text": "getting out, reaching safety, finding each other.",
     "startFrame": 3260,
     "durationFrames": 66,
     "endFrame": 3326,
     "seconds": 2.732,
     "audio": "audio/narration_tts/S04_10.wav",
     "audioKind": "tts",
     "captionStart": 3260,
     "captionEnd": 3332
    }
   ],
