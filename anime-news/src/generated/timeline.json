  {
   "id": "S03",
   "chapter": "Israel: the arithmetic of power",
   "startFrame": 1406,
   "durationFrames": 974,
   "planStartSec": 62,
   "planDurationSec": 41,
   "sourceIds": [
    "F02"
   ],
   "assetIds": [
    "A04",
    "A05",
    "A15"
   ],
   "cues": [
    {
     "id": "S03_01",
     "text": "In Israel, the votes are counted. Forming a government is the next battle.",
     "startFrame": 1412,
     "durationFrames": 111,
     "endFrame": 1523,
     "seconds": 4.609,
     "audio": "audio/narration_tts/S03_01.wav",
     "audioKind": "tts",
     "captionStart": 1412,
     "captionEnd": 1529
    },
    {
     "id": "S03_02",
     "text": "Results released on Friday gave Benjamin Netanyahu’s bloc fifty-three seats.",
     "startFrame": 1531,
     "durationFrames": 115,
     "endFrame": 1646,
     "seconds": 4.771,
     "audio": "audio/narration_tts/S03_02.wav",
     "audioKind": "tts",
     "captionStart": 1531,
     "captionEnd": 1652
    },
    {
     "id": "S03_03",
     "text": "The main opposition bloc took forty-eight.",
     "startFrame": 1656,
     "durationFrames": 62,
     "endFrame": 1718,
     "seconds": 2.572,
     "audio": "audio/narration_tts/S03_03.wav",
     "audioKind": "tts",
     "captionStart": 1656,
     "captionEnd": 1724
    },
    {
     "id": "S03_04",
     "text": "Arab-led parties held nineteen.",
     "startFrame": 1728,
     "durationFrames": 55,
     "endFrame": 1783,
     "seconds": 2.251,
     "audio": "audio/narration_tts/S03_04.wav",
     "audioKind": "tts",
     "captionStart": 1728,
     "captionEnd": 1789
    },
    {
     "id": "S03_05",
     "text": "For an outright majority, the target is sixty-one seats",
     "startFrame": 1795,
     "durationFrames": 86,
     "endFrame": 1881,
     "seconds": 3.571,
     "audio": "audio/narration_tts/S03_05.wav",
     "audioKind": "tts",
     "captionStart": 1795,
     "captionEnd": 1885
    },
    {
     "id": "S03_06",
     "text": "in the one-hundred-and-twenty-seat parliament.",
     "startFrame": 1885,
     "durationFrames": 65,
     "endFrame": 1950,
     "seconds": 2.681,
     "audio": "audio/narration_tts/S03_06.wav",
     "audioKind": "tts",
     "captionStart": 1885,
     "captionEnd": 1956
    },
    {
     "id": "S03_07",
     "text": "Netanyahu remains prime minister while parties try to build a coalition.",
     "startFrame": 1968,
     "durationFrames": 106,
     "endFrame": 2074,
     "seconds": 4.411,
     "audio": "audio/narration_tts/S03_07.wav",
     "audioKind": "tts",
     "captionStart": 1968,
     "captionEnd": 2080
    },
    {
     "id": "S03_08",
     "text": "Those nineteen seats do not automatically belong to either main bloc.",
     "startFrame": 2082,
     "durationFrames": 110,
     "endFrame": 2192,
     "seconds": 4.579,
     "audio": "audio/narration_tts/S03_08.wav",
     "audioKind": "tts",
     "captionStart": 2082,
     "captionEnd": 2198
    },
    {
     "id": "S03_09",
     "text": "The election is over.",
     "startFrame": 2200,
     "durationFrames": 43,
     "endFrame": 2243,
     "seconds": 1.792,
     "audio": "audio/narration_tts/S03_09.wav",
     "audioKind": "tts",
     "captionStart": 2200,
     "captionEnd": 2249
    },
    {
     "id": "S03_10",
     "text": "The struggle to turn votes into a governing majority continues.",
     "startFrame": 2251,
     "durationFrames": 99,
     "endFrame": 2350,
     "seconds": 4.11,
     "audio": "audio/narration_tts/S03_10.wav",
     "audioKind": "tts",
     "captionStart": 2251,
     "captionEnd": 2356
    }
   ],
   "visualCues": [
