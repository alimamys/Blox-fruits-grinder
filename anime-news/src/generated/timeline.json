     "durationFrames": 46,
     "endFrame": 3901,
     "seconds": 1.909,
     "audio": "audio/narration_tts/S05_06.wav",
     "audioKind": "tts",
     "captionStart": 3855,
     "captionEnd": 3907
    },
    {
     "id": "S05_07",
     "text": "Later clashes involving smaller groups broke out in Paris and other cities.",
     "startFrame": 3915,
     "durationFrames": 114,
     "endFrame": 4029,
     "seconds": 4.73,
     "audio": "audio/narration_tts/S05_07.wav",
     "audioKind": "tts",
     "captionStart": 3915,
     "captionEnd": 4035
    },
    {
