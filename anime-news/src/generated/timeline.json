    "A14"
   ],
   "cues": [
    {
     "id": "S05_01",
     "text": "In France, the pressure moved onto the streets.",
     "startFrame": 3411,
     "durationFrames": 67,
     "endFrame": 3478,
     "seconds": 2.785,
     "audio": "audio/narration_tts/S05_01.wav",
     "audioKind": "tts",
     "captionStart": 3411,
     "captionEnd": 3484
    },
    {
     "id": "S05_02",
     "text": "Saturday brought a third consecutive weekend of demonstrations",
     "startFrame": 3486,
     "durationFrames": 100,
     "endFrame": 3586,
     "seconds": 4.15,
     "audio": "audio/narration_tts/S05_02.wav",
     "audioKind": "tts",
     "captionStart": 3486,
     "captionEnd": 3590
    },
    {
     "id": "S05_03",
     "text": "over living costs and education.",
     "startFrame": 3590,
     "durationFrames": 64,
     "endFrame": 3654,
     "seconds": 2.627,
     "audio": "audio/narration_tts/S05_03.wav",
     "audioKind": "tts",
     "captionStart": 3590,
     "captionEnd": 3660
    },
    {
     "id": "S05_04",
     "text": "Authorities estimated three-hundred-and-twenty-thousand participants across the country.",
     "startFrame": 3662,
     "durationFrames": 128,
     "endFrame": 3790,
     "seconds": 5.294,
     "audio": "audio/narration_tts/S05_04.wav",
     "audioKind": "tts",
     "captionStart": 3662,
     "captionEnd": 3796
    },
    {
     "id": "S05_05",
     "text": "Organizers put the number higher.",
     "startFrame": 3798,
     "durationFrames": 54,
     "endFrame": 3852,
     "seconds": 2.233,
     "audio": "audio/narration_tts/S05_05.wav",
     "audioKind": "tts",
     "captionStart": 3798,
     "captionEnd": 3858
    },
    {
     "id": "S05_06",
     "text": "Most people marched peacefully.",
