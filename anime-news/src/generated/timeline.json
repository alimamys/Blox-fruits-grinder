  {
   "id": "S05",
   "chapter": "France: pressure in the streets",
   "startFrame": 3405,
   "durationFrames": 946,
   "planStartSec": 143,
   "planDurationSec": 37,
   "sourceIds": [
    "F04"
   ],
   "assetIds": [
    "A08",
