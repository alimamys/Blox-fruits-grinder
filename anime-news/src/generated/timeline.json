  {
   "id": "S04",
   "chapter": "Ukraine: a narrow opening",
   "startFrame": 2380,
   "durationFrames": 1025,
   "planStartSec": 103,
   "planDurationSec": 40,
   "sourceIds": [
    "F03"
   ],
   "assetIds": [
    "A06",
