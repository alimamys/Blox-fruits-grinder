     "seconds": 1.603,
     "audio": "audio/narration_scratch/S04_03.wav",
     "audioKind": "scratch",
     "captionStart": 2604,
     "captionEnd": 2649
    },
    {
     "id": "S04_04",
     "text": "Their route ran through Russia and Belarus,",
     "startFrame": 2651,
     "durationFrames": 56,
