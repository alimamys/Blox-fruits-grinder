     "startFrame": 3690,
     "durationFrames": 48,
     "endFrame": 3738,
     "seconds": 1.975,
     "audio": "audio/narration_scratch/S05_05.wav",
     "audioKind": "scratch",
     "captionStart": 3690,
     "captionEnd": 3744
    },
    {
     "id": "S05_06",
     "text": "Most people marched peacefully.",
