  {
   "id": "S02",
   "chapter": "The Gulf: a proposal, not a deal",
   "startFrame": 454,
   "durationFrames": 932,
   "planStartSec": 18,
   "planDurationSec": 44,
   "sourceIds": [
    "F01"
   ],
   "assetIds": [
    "A01",
    "A03",
    "A02",
    "A14"
   ],
   "cues": [
    {
     "id": "S02_01",
     "text": "We start in the Gulf, where diplomacy continued under the threat of renewed strikes.",
     "startFrame": 460,
     "durationFrames": 129,
     "endFrame": 589,
     "seconds": 5.336,
     "audio": "audio/narration_scratch/S02_01.wav",
     "audioKind": "scratch",
     "captionStart": 460,
     "captionEnd": 595
    },
    {
     "id": "S02_02",
     "text": "On Sunday, Iranian negotiators were in Doha for talks with Qatari mediators,",
     "startFrame": 597,
     "durationFrames": 116,
     "endFrame": 713,
     "seconds": 4.812,
     "audio": "audio/narration_scratch/S02_02.wav",
     "audioKind": "scratch",
     "captionStart": 597,
     "captionEnd": 717
    },
    {
     "id": "S02_03",
     "text": "seeking a way to end the war involving Iran, the United States and Israel.",
     "startFrame": 717,
     "durationFrames": 126,
     "endFrame": 843,
     "seconds": 5.23,
     "audio": "audio/narration_scratch/S02_03.wav",
     "audioKind": "scratch",
     "captionStart": 717,
     "captionEnd": 849
    },
    {
     "id": "S02_04",
     "text": "Iran’s foreign minister described a proposal that could reopen the Strait of Hormuz",
     "startFrame": 851,
     "durationFrames": 117,
     "endFrame": 968,
     "seconds": 4.86,
     "audio": "audio/narration_scratch/S02_04.wav",
     "audioKind": "scratch",
     "captionStart": 851,
     "captionEnd": 972
    },
    {
     "id": "S02_05",
     "text": "within two days of a possible agreement with Washington.",
     "startFrame": 972,
     "durationFrames": 81,
     "endFrame": 1053,
     "seconds": 3.355,
     "audio": "audio/narration_scratch/S02_05.wav",
     "audioKind": "scratch",
     "captionStart": 972,
     "captionEnd": 1059
    },
    {
     "id": "S02_06",
     "text": "But he said no final agreement had been reached.",
     "startFrame": 1065,
     "durationFrames": 69,
     "endFrame": 1134,
     "seconds": 2.854,
     "audio": "audio/narration_scratch/S02_06.wav",
     "audioKind": "scratch",
     "captionStart": 1065,
     "captionEnd": 1140
    },
    {
     "id": "S02_07",
     "text": "The shipping route remains central to the negotiations.",
     "startFrame": 1146,
     "durationFrames": 77,
     "endFrame": 1223,
     "seconds": 3.186,
     "audio": "audio/narration_scratch/S02_07.wav",
     "audioKind": "scratch",
     "captionStart": 1146,
     "captionEnd": 1229
    },
    {
     "id": "S02_08",
     "text": "For now, the diplomatic breakthrough is still a possibility—not an announced outcome.",
     "startFrame": 1231,
     "durationFrames": 125,
     "endFrame": 1356,
     "seconds": 5.183,
     "audio": "audio/narration_scratch/S02_08.wav",
     "audioKind": "scratch",
     "captionStart": 1231,
     "captionEnd": 1362
    }
   ],
   "visualCues": [
