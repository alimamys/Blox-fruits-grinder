  {
   "id": "S03",
   "chapter": "Israel: the arithmetic of power",
   "startFrame": 1399,
   "durationFrames": 974,
   "planStartSec": 62,
   "planDurationSec": 41,
   "sourceIds": [
    "F02"
   ],
   "assetIds": [
    "A04",
    "A05",
    "A15"
   ],
   "cues": [
    {
     "id": "S03_01",
     "text": "In Israel, the votes are counted. Forming a government is the next battle.",
     "startFrame": 1405,
     "durationFrames": 111,
     "endFrame": 1516,
     "seconds": 4.609,
     "audio": "audio/narration_tts/S03_01.wav",
     "audioKind": "tts",
     "captionStart": 1405,
     "captionEnd": 1522
    },
    {
     "id": "S03_02",
     "text": "Results released on Friday gave Benjamin Netanyahu’s bloc fifty-three seats.",
     "startFrame": 1524,
     "durationFrames": 115,
     "endFrame": 1639,
     "seconds": 4.771,
     "audio": "audio/narration_tts/S03_02.wav",
     "audioKind": "tts",
     "captionStart": 1524,
     "captionEnd": 1645
    },
    {
     "id": "S03_03",
     "text": "The main opposition bloc took forty-eight.",
     "startFrame": 1649,
     "durationFrames": 62,
     "endFrame": 1711,
     "seconds": 2.572,
     "audio": "audio/narration_tts/S03_03.wav",
     "audioKind": "tts",
     "captionStart": 1649,
     "captionEnd": 1717
    },
    {
     "id": "S03_04",
     "text": "Arab-led parties held nineteen.",
     "startFrame": 1721,
     "durationFrames": 55,
     "endFrame": 1776,
     "seconds": 2.251,
     "audio": "audio/narration_tts/S03_04.wav",
     "audioKind": "tts",
     "captionStart": 1721,
     "captionEnd": 1782
    },
    {
     "id": "S03_05",
     "text": "For an outright majority, the target is sixty-one seats",
     "startFrame": 1788,
     "durationFrames": 86,
     "endFrame": 1874,
     "seconds": 3.571,
     "audio": "audio/narration_tts/S03_05.wav",
     "audioKind": "tts",
     "captionStart": 1788,
     "captionEnd": 1878
    },
    {
     "id": "S03_06",
     "text": "in the one-hundred-and-twenty-seat parliament.",
     "startFrame": 1878,
     "durationFrames": 65,
     "endFrame": 1943,
     "seconds": 2.681,
     "audio": "audio/narration_tts/S03_06.wav",
     "audioKind": "tts",
     "captionStart": 1878,
     "captionEnd": 1949
    },
    {
     "id": "S03_07",
     "text": "Netanyahu remains prime minister while parties try to build a coalition.",
     "startFrame": 1961,
     "durationFrames": 106,
     "endFrame": 2067,
     "seconds": 4.411,
     "audio": "audio/narration_tts/S03_07.wav",
     "audioKind": "tts",
     "captionStart": 1961,
     "captionEnd": 2073
    },
    {
     "id": "S03_08",
     "text": "Those nineteen seats do not automatically belong to either main bloc.",
     "startFrame": 2075,
     "durationFrames": 110,
     "endFrame": 2185,
     "seconds": 4.579,
     "audio": "audio/narration_tts/S03_08.wav",
     "audioKind": "tts",
     "captionStart": 2075,
     "captionEnd": 2191
    },
    {
     "id": "S03_09",
     "text": "The election is over.",
     "startFrame": 2193,
     "durationFrames": 43,
     "endFrame": 2236,
     "seconds": 1.792,
     "audio": "audio/narration_tts/S03_09.wav",
     "audioKind": "tts",
     "captionStart": 2193,
     "captionEnd": 2242
    },
    {
     "id": "S03_10",
     "text": "The struggle to turn votes into a governing majority continues.",
     "startFrame": 2244,
     "durationFrames": 99,
     "endFrame": 2343,
     "seconds": 4.11,
     "audio": "audio/narration_tts/S03_10.wav",
     "audioKind": "tts",
     "captionStart": 2244,
     "captionEnd": 2349
    }
   ],
   "visualCues": [
