   ],
   "cues": [
    {
     "id": "S05_01",
     "text": "In France, the pressure moved onto the streets.",
     "startFrame": 3344,
     "durationFrames": 77,
     "endFrame": 3421,
     "seconds": 3.176,
     "audio": "audio/narration_scratch/S05_01.wav",
     "audioKind": "scratch",
     "captionStart": 3344,
     "captionEnd": 3427
    },
    {
     "id": "S05_02",
     "text": "Saturday brought a third consecutive weekend of demonstrations",
     "startFrame": 3429,
     "durationFrames": 78,
     "endFrame": 3507,
     "seconds": 3.217,
     "audio": "audio/narration_scratch/S05_02.wav",
     "audioKind": "scratch",
     "captionStart": 3429,
     "captionEnd": 3511
    },
    {
     "id": "S05_03",
     "text": "over living costs and education.",
