{
  "name": "passenger63-horror",
  "version": "1.0.0",
  "private": true,
  "description": "The 63rd Passenger - a stick-figure maritime horror documentary built with Remotion",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "build-sfx": "node scripts/build-sfx.mjs",
    "generate-voices": "node scripts/generate-voices.mjs",
    "retime": "node scripts/retime.mjs",
    "render": "node scripts/render.mjs",
    "render:raw": "remotion render src/index.ts Passenger63Horror out/passenger63.mp4",
    "audio-preview": "node scripts/render.mjs --audio-only",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
